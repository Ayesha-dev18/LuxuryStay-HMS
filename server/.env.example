# Copy to .env and fill in. Never commit the real file.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/luxurystay

# At least 32 random characters, for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Address of the client. Password-reset links and CORS use this.
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# Hotel-local calendar for stay dates
HOTEL_TIMEZONE=Asia/Karachi

# Email for password-reset links (Gmail app password by default)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# EMAIL_FROM=LuxuryStay <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# Set to 1 when running behind a reverse proxy
# TRUST_PROXY=

# Identity documents. DOCUMENT_KEY encrypts uploaded documents on disk
# (at least 32 random characters). Keep it safe: documents encrypted with it
# cannot be opened without it. Without it, identity-document uploads are
# refused (503); documents are never stored unencrypted.
DOCUMENT_KEY=
# UPLOAD_DIR=
# OCR_TIMEOUT_MS=20000
